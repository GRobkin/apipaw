# ID del proyecto de Firebase (el mismo que usa la app Flutter).
FIREBASE_PROJECT_ID=pawlife-84d14

# Credenciales de la service account, para que el backend pueda escribir en
# Firestore saltandose las reglas de seguridad del cliente.
#
# Se saca en: consola de Firebase > Configuracion del proyecto > Cuentas de
# servicio > Generar nueva clave privada. Pega el JSON entero en una sola
# linea, o su version en base64 (recomendado en Vercel: el JSON trae saltos
# de linea dentro de private_key que la UI a veces maltrata).
#
#   base64 -w0 service-account.json
FIREBASE_SERVICE_ACCOUNT=

# Origenes permitidos por CORS, separados por coma. Solo importa si algun dia
# compilas la app para Flutter Web; en Android/iOS no hay preflight.
# "*" permite cualquiera.
ALLOWED_ORIGINS=*
